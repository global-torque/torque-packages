{
  "name": "@global-torque/torque-packages-workspace",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "typecheck": "pnpm --filter './packages/*' -r run typecheck",
    "test:run": "pnpm --filter './packages/*' -r run test:run",
    "lint": "node scripts/check-framework-boundaries.mjs",
    "check:runtime-deps": "node scripts/check-runtime-deps.mjs",
    "check:packlist": "node scripts/check-packlist.mjs",
    "verify-candidate": "node scripts/verify-candidate.mjs",
    "verify-ui-kit-overlay": "node scripts/verify-ui-kit-overlay.mjs",
    "verify-archive-consumers": "node scripts/verify-archive-consumers.mjs",
    "test:release": "node scripts/test-release-contracts.mjs",
    "pack:candidate": "node scripts/pack-candidate.mjs",
    "check": "pnpm run verify-candidate && pnpm run typecheck && pnpm run test:run && pnpm run lint && pnpm run check:runtime-deps && pnpm run check:packlist",
    "release:verify": "node scripts/verify-release-bundle.mjs",
    "build:node": "pnpm --filter @global-torque/invest-core run build:node && pnpm --filter @global-torque/invest-runtime run build:node"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/server-renderer": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "@playwright/test": "1.61.1",
    "eslint": "9.39.4",
    "happy-dom": "^20.12.0",
    "jsdom": "^27.4.0",
    "prettier": "3.9.5",
    "sass": "^1.101.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vite-svg-loader": "^5.1.1",
    "vitest": "4.1.11",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-tsc": "^3.3.6"
  }
}
