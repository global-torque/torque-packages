{
  "name": "@global-torque/invest-shell",
  "private": false,
  "version": "0.4.10",
  "description": "Investment application shell components, navigation, runtime facades, and styles.",
  "license": "MIT",
  "engines": { "node": "^24.21.0" },
  "packageManager": "pnpm@12.4.2",
  "sideEffects": ["**/*.vue", "**/*.css", "**/*.scss", "./src/styles.ts"],
  "type": "module",
  "scripts": {
    "css:budget": "node scripts/check-css-budget.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:run": "node scripts/check-css-contract.mjs && node --test scripts/check-css-budget.test.mjs && NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" vitest run",
    "test:css-browser": "node scripts/check-css-browser.mjs"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components.ts",
    "./config": "./src/config.ts",
    "./runtime": "./src/runtime.ts",
    "./pwa": "./src/pwa.ts",
    "./styles": "./src/styles.ts",
    "./styles/geometry.css": "./src/styles/geometry.css",
    "./styles/components.css": "./src/styles/components.css",
    "./navigation": "./src/navigation.ts",
    "./directives": "./src/directives.ts",
    "./error-pages": "./src/error-pages.ts"
  },
  "dependencies": {
    "@global-torque/ui-kit": "0.1.4",
    "@global-torque/ui-primitives": "0.1.3",
    "@lucide/vue": "^1.46.0",
    "@vueuse/core": "^15.0.0",
    "@global-torque/domain-types": "workspace:*",
    "@global-torque/invest-core": "workspace:*",
    "@global-torque/invest-runtime": "workspace:*",
    "@global-torque/invest-widgets": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@global-torque/design-tokens": "0.3.0",
    "@vue/server-renderer": "^3.5.39",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vite-svg-loader": "^5.1.0",
    "vitest": "catalog:",
    "pinia": "^4.0.3",
    "sass": "^1.101.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "peerDependencies": {
    "@global-torque/design-tokens": ">=0.2.1 <0.4.0",
    "ajv": "^8.20.0",
    "pinia": "^3.0.4 || ^4.0.3",
    "reka-ui": "^2.10.1",
    "sass": "^1.101.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "@global-torque/design-tokens": { "optional": true }
  },
  "files": ["src", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md", "SECURITY.md", "SUPPORT.md", "css-budget.json", "scripts", "vite.config.ts", "vitest.config.ts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/torque-packages.git",
    "directory": "packages/invest-shell"
  },
  "homepage": "https://github.com/global-torque/torque-packages#readme",
  "bugs": { "url": "https://github.com/global-torque/torque-packages/issues" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "latest" }
}
