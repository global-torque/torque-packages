{
  "name": "@global-torque/invest-runtime",
  "private": false,
  "version": "0.4.0",
  "description": "Investment runtime context, session lifecycle, adapters, and PWA services.",
  "license": "MIT",
  "engines": { "node": "^24.21.0" },
  "packageManager": "pnpm@12.4.2",
  "sideEffects": ["**/*.vue", "**/*.css", "**/*.scss"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters.ts",
    "./application-context": "./src/applicationContext.ts",
    "./analytics": "./src/analytics/index.ts",
    "./analytics/*": "./src/analytics/*.ts",
    "./api-client-hooks": "./src/apiClientDefaultHooks.ts",
    "./chunk-error-handling": "./src/chunkErrorHandling.ts",
    "./client/useClientIp": "./src/client/useClientIp.ts",
    "./config": "./src/config.ts",
    "./dialogs": "./src/dialogs/store/useDialogs.ts",
    "./error-handling": "./src/errorHandling.ts",
    "./error/*": "./src/error/*.ts",
    "./filer": "./src/filer/index.ts",
    "./install": "./src/install.ts",
    "./lifecycle": "./src/lifecycle/domainLifecycle.ts",
    "./native-push": "./src/nativePush/nativePushBridge.ts",
    "./native-push/core": "./src/nativePush/nativePushCore.ts",
    "./navigation": "./src/navigation/navigateWithQueryParams.ts",
    "./pwa": "./src/pwa/index.ts",
    "./pwa/pwaPolicy": {
      "types": "./src/pwa/pwaPolicy.ts",
      "node": "./dist/node/pwa/pwaPolicy.js",
      "default": "./src/pwa/pwaPolicy.ts"
    },
    "./pwa/*": "./src/pwa/*.ts",
    "./profiles": "./src/profiles/store/useProfiles.ts",
    "./repository/action-state": "./src/repository/actionState.ts",
    "./loader": "./src/presentation/useGlobalLoader.ts",
    "./reset": "./src/resetAllData.ts",
    "./session": "./src/session/store/useSession.ts",
    "./session/offline": "./src/session/offlineSession.ts",
    "./websockets": "./src/websockets/useDomainWebSocketStore.ts",
    "./global-alert": "./src/globalAlert/useGlobalAlert.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:run": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-experimental-webstorage\" vitest run",
    "build:node": "tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/local-notifications": "^8.2.0",
    "@global-torque/client-error-handling": "0.1.0",
    "@global-torque/sdk": "0.3.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@global-torque/domain-types": "workspace:*",
    "@global-torque/invest-core": "workspace:*",
    "@global-torque/invest-data": "workspace:*",
    "firebase": "^12.15.0",
    "universal-cookie": "^8.1.0",
    "uuid": "^14.0.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vitest": "catalog:",
    "pinia": "^4.0.3",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "peerDependencies": {
    "pinia": "^3.0.4 || ^4.0.3",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "files": ["src", "dist/node/pwa/pwaPolicy.js", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md", "SECURITY.md", "SUPPORT.md", "vitest.config.ts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/torque-packages.git",
    "directory": "packages/invest-runtime"
  },
  "homepage": "https://github.com/global-torque/torque-packages#readme",
  "bugs": { "url": "https://github.com/global-torque/torque-packages/issues" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "latest" }
}
