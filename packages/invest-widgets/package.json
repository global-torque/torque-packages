{
  "name": "@global-torque/invest-widgets",
  "private": false,
  "version": "0.4.5",
  "description": "Provider-driven reusable investment widgets and chart surfaces.",
  "license": "MIT",
  "engines": { "node": "^24.21.0" },
  "packageManager": "pnpm@12.4.2",
  "sideEffects": ["**/*.vue", "**/*.css", "**/*.scss"],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./accreditation": "./src/accreditation/index.ts",
    "./accreditation/*": "./src/accreditation/*",
    "./charts/area": "./src/charts/area/index.ts",
    "./charts/donut": "./src/charts/donut/index.ts",
    "./comments": "./src/comments/index.ts",
    "./comments/*": "./src/comments/*",
    "./filer": "./src/filer/index.ts",
    "./filer/*": "./src/filer/*",
    "./icons": "./src/icons/index.ts",
    "./icons/action": "./src/icons/action.ts",
    "./icons/default-image": "./src/icons/default-image.ts",
    "./icons/file": "./src/icons/file.ts",
    "./icons/images/*": "./src/icons/images/*",
    "./icons/navigation": "./src/icons/navigation.ts",
    "./info": "./src/info/index.ts",
    "./info/*": "./src/info/*",
    "./kyc": "./src/kyc/index.ts",
    "./kyc/*": "./src/kyc/*",
    "./navigation": "./src/navigation/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./notifications/*": "./src/notifications/*",
    "./offers": "./src/offers/index.ts",
    "./offers/*": "./src/offers/*",
    "./profiles": "./src/profiles/index.ts",
    "./profiles/*": "./src/profiles/*",
    "./providers": "./src/providers.ts",
    "./socials": "./src/socials/index.ts",
    "./wallet": "./src/wallet/index.ts",
    "./wallet/*": "./src/wallet/*"
  },
  "scripts": {
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@global-torque/ui-kit": "0.1.4",
    "@global-torque/ui-primitives": "0.1.3",
    "@lucide/vue": "^1.46.0",
    "@unovis/ts": "1.7.0",
    "@unovis/vue": "1.7.0",
    "@vueuse/core": "^15.0.0",
    "@global-torque/domain-types": "workspace:*",
    "@global-torque/invest-core": "workspace:*",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-vue": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.12.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vite-svg-loader": "^5.1.0",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.6"
  },
  "peerDependencies": {
    "reka-ui": "^2.10.1",
    "vue": "^3.5.39"
  },
  "files": ["src", "README.md", "LICENSE", "NOTICE.md", "CHANGELOG.md", "SECURITY.md", "SUPPORT.md", "vite.config.ts", "vitest.config.ts"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/global-torque/torque-packages.git",
    "directory": "packages/invest-widgets"
  },
  "homepage": "https://github.com/global-torque/torque-packages#readme",
  "bugs": { "url": "https://github.com/global-torque/torque-packages/issues" },
  "publishConfig": { "access": "public", "provenance": true, "tag": "latest" }
}
